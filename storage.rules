rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mirrors firestore.rules' isMember(): only allow-listed team members
    // (not just any signed-in Google account) may read/write files here.
    function isMember() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/team-ops/v1/members/$(request.auth.uid));
    }

    match /team-ops/v1/{allPaths=**} {
      allow read: if isMember();
      allow write: if isMember()
                     && request.resource.size < 10 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
    }
  }
}
