rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Any signed-in user may read/write files under the app's storage prefix.
    // Firestore rules already gate which signed-in users can reach this app's
    // data (see firestore.rules); this mirrors that at the storage layer.
    match /team-ops/v1/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                     && request.resource.size < 10 * 1024 * 1024
                     && (request.resource.contentType.matches('image/.*')
                         || request.resource.contentType == 'application/pdf');
    }
  }
}
