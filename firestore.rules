rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Team-shared data — any signed-in team member can read/write everything.
    // v1 has no roles; a future admin-only tier could add
    // `request.auth.token.role == 'admin'` checks here without changing the path shape.
    match /team-ops/v1/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
