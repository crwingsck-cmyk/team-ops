rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/team-ops/v1/members/$(request.auth.uid));
    }

    // Each signed-in user may read their own membership record, to know
    // whether they've been allow-listed. Membership docs are only ever
    // written by an admin directly in the Firestore console (or later via
    // a Cloud Function/Admin SDK) — never from the client.
    match /team-ops/v1/members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Every other collection is shared team data — any allow-listed member
    // can read/write everything (v1 has no further role distinctions).
    match /team-ops/v1/{collection}/{document=**} {
      allow read, write: if collection != 'members' && isMember();
    }
  }
}
