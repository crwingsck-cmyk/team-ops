rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/team-ops/v1/members/$(request.auth.uid));
    }

    function isAdmin() {
      return isMember() &&
        get(/databases/$(database)/documents/team-ops/v1/members/$(request.auth.uid)).data.get('role', 'member') == 'admin';
    }

    function unchangedDeletedAt() {
      return resource.data.get('deletedAt', null) == request.resource.data.get('deletedAt', null);
    }

    // Each signed-in user may read their own membership record (and its role),
    // to know whether they've been allow-listed and what they can do.
    // An admin may also read every member doc (to manage the roster) and is
    // the only one who can add, edit, or remove membership records.
    match /team-ops/v1/members/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Append-only audit trail — any member can read/write new entries,
    // nobody can edit or delete existing ones (integrity of the log).
    match /team-ops/v1/activityLog/{document=**} {
      allow read, create: if isMember();
      allow update, delete: if false;
    }

    // Every other collection is shared team data. Any member can read,
    // create, and edit. "Delete" in the UI is implemented as a soft-delete
    // (an update that sets deletedAt) — unchangedDeletedAt() stops a regular
    // member from toggling that field themselves, so only an admin can
    // soft-delete, restore, or permanently delete.
    match /team-ops/v1/{collection}/{document=**} {
      allow read: if collection != 'members' && collection != 'activityLog' && isMember();
      allow create: if collection != 'members' && collection != 'activityLog' && isMember();
      allow update: if collection != 'members' && collection != 'activityLog' && isMember()
                      && (isAdmin() || unchangedDeletedAt());
      allow delete: if collection != 'members' && collection != 'activityLog' && isAdmin();
    }
  }
}
